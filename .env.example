# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Job Search APIs (at least one required)
# JSearch via RapidAPI — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key_here

# SerpAPI — https://serpapi.com (alternative/fallback)
SERPAPI_KEY=your_serpapi_key_here

# Google Sheets Tracker (optional — local CSV used if not set)
# Download credentials JSON from Google Cloud Console > Service Accounts
GOOGLE_CREDENTIALS_JSON=path/to/credentials.json
GOOGLE_SHEET_NAME=Job Applications Tracker
